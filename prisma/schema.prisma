generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

enum UserRole {
  ADMIN
  TRAINER
  PARENT
}

enum BookingStatus {
  BOOKED
  CANCELED
}

enum ClassStatus {
  SCHEDULED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String?  // MVP credentials auth
  name         String
  phone        String?
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trainerProfile TrainerProfile?
  children       Child[]          @relation("ParentChildren")
  bookings       Booking[]        @relation("ParentBookings")
  payments       PaymentRecord[]  @relation("ParentPayments")
}

model TrainerProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  bio       String?
  specialties String?
  isActive  Boolean  @default(true)

  user      User     @relation(fields: [userId], references: [id])
  classes   ClassSession[]
}

model Child {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String   @db.ObjectId
  name      String
  birthDate DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    User     @relation("ParentChildren", fields: [parentId], references: [id])
  bookings  Booking[]
  
  @@index([parentId])
}

model Hall {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks   HallBlock[]
  classes  ClassSession[]
  
  @@index([isActive])
}

model HallBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  hallId    String   @db.ObjectId
  startAt   DateTime
  endAt     DateTime
  reason    String
  createdByAdminId String @db.ObjectId
  createdAt DateTime @default(now())

  hall      Hall     @relation(fields: [hallId], references: [id])

  @@index([hallId, startAt])
  @@index([hallId, endAt])
}

model ClassSession {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String     @db.ObjectId
  hallId    String     @db.ObjectId
  startAt   DateTime
  endAt     DateTime
  capacity  Int
  takenSeats Int       @default(0)
  status    ClassStatus @default(SCHEDULED)
  price     Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  trainer   TrainerProfile @relation(fields: [trainerId], references: [id])
  hall      Hall           @relation(fields: [hallId], references: [id])
  bookings  Booking[]

  @@index([trainerId, startAt])
  @@index([hallId, startAt])
  @@index([status, startAt])
}

model Booking {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  classSessionId String       @db.ObjectId
  childId       String        @db.ObjectId
  parentId      String        @db.ObjectId
  status        BookingStatus @default(BOOKED)
  createdAt     DateTime      @default(now())
  canceledAt    DateTime?

  classSession  ClassSession  @relation(fields: [classSessionId], references: [id])
  child         Child         @relation(fields: [childId], references: [id])
  parent        User          @relation("ParentBookings", fields: [parentId], references: [id])

  @@index([classSessionId])
  @@index([parentId, createdAt])
  @@index([childId, createdAt])
  // Prisma Mongo НЕ завжди гарантує partial unique на status,
  // але корисно мати логічну перевірку: 1 active booking per child per class.
  // Можна додати @@unique([classSessionId, childId]) і при cancel створювати новий booking не дозволяти.
  @@unique([classSessionId, childId])
}

model PaymentRecord {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String        @db.ObjectId
  month     String        // "2026-01"
  amount    Int
  status    PaymentStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parent    User          @relation("ParentPayments", fields: [parentId], references: [id])

  @@index([parentId, month])
  @@index([status, month])
  @@unique([parentId, month])
}
